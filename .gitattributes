# Normaliza fin de linea: texto siempre se guarda como LF en el repo,
# git lo convierte a CRLF al hacer checkout en Windows si hace falta.
# Esto elimina los warnings de "LF will be replaced by CRLF".
* text=auto eol=lf

# Binarios de Godot y assets: nunca tocar fin de linea
*.png binary
*.jpg binary
*.jpeg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.import binary

# Recursos de Godot en texto plano: se benefician del diff pero deben ser LF
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
*.godot text eol=lf
