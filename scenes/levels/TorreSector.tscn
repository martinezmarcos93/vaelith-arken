position = Vector2(206, 228)
recognition_lines = []
memory_lines = ["La empuñadura encaja en tu mano. Demasiado bien.", "Tus dedos encuentran el lugar exacto. El peso no te resulta extraño.", "Lo extraño es no recordar haber aprendido a usarla.", "Pantalla negra. Una respiración.", "—¿Qué querés que sea?", "Una habitación. Una mesa de piedra.", "Sobre ella yace una criatura incompleta. Carne. Metal. Hueso.", "Una figura permanece frente a ella. No se ve su rostro.", "—Yo.", "La criatura abre los ojos.", "—No. Mejor que yo.", "Volvés. Respirás agitado. Mirás la espada.", "No comprendés lo que acabás de ver."]
counts_as_memory = true

