[node name="DoorSymbolTrigger" parent="." instance=ExtResource("4_dialogue_trigger")]
position = Vector2(915, 400)
lines = ["Sobre el marco hay un símbolo tallado.", "No sabés qué significa. Pero lo reconocés.", "La sensación dura apenas un instante:", "Una habitación. Una voz. El olor de la sangre sobre piedra.", "Y algo peor: la certeza de que alguna vez lo entendiste perfectamente."]

[node name="NoMuertoErrante1" parent="." instance=ExtResource("2_no_muerto")]
position = Vector2(1000, 400)

[node name="PostCombatTrigger" parent="." instance=ExtResource("4_dialogue_trigger")]
position = Vector2(1180, 400)
lines = ["Sabés qué está pasando. No sabés cómo lo sabés.", "Pero sabés que eso no debería estar caminando.", "Y una pregunta te resulta insoportable: ¿por qué lo reconocés?"]

[node name="DescentTrigger" parent="." instance=ExtResource("4_dialogue_trigger")]
position = Vector2(1330, 400)
lines = ["El camino baja hacia la niebla. A lo lejos, una estructura enorme, medio oculta.", "No recordás haber estado aquí.", "Pero algo en estas ruinas te resulta familiar.", "No como un lugar que hayas visitado.", "Como una herida que todavía reconoce el cuchillo."]

