[node name="DialogueTrigger6" parent="." instance=ExtResource("17_dialogue")]
position = Vector2(2320, 416)
lines = ["Hay restos de arquitectura alrededor, pero nada que puedas identificar como una casa, un templo o una fortaleza."]

[node name="DialogueTrigger7" parent="." instance=ExtResource("17_dialogue")]
position = Vector2(2545, 406)
lines = ["Sobre el marco, un símbolo tallado.", "No sabés qué significa. Pero lo reconocés.", "Y por un instante, la certeza de que alguna vez lo entendiste perfectamente."]

[node name="DialogueTrigger3" parent="." instance=ExtResource("17_dialogue")]
position = Vector2(2900, 418)
lines = ["Otra espada, clavada en el suelo. El mismo diseño que la tuya.", "Alguien con tu mano estuvo aquí. Y no hace mucho."]

