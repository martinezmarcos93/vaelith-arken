lines = ["Observás al constructo practicar. El mismo movimiento, una y otra vez.", "—Otra vez. Obedece.", "—Más rápido. Obedece.", "—¿Para qué?", "—Algún día vas a necesitar hacerlo.", "—¿Para qué?", "—Para reemplazarme.", "Levanta la cabeza. —¿Vas a morir?", "—Todos mueren.", "—Vos también.", "No respondés."]

